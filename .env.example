# Optional: raises the GitHub Search API fallback rate limit.
# Keep this server-side. Never expose it with a NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=

# Optional: official Meta Instagram oEmbed server connection.
# Both values are required before Instagram public URL import is enabled.
INSTAGRAM_OEMBED_ENDPOINT=
INSTAGRAM_OEMBED_TOKEN=

# Optional server-side OpenAI-compatible multimodal provider.
# The API remains unavailable until all three values are configured.
# Never expose the key with a NEXT_PUBLIC_ prefix.
MULTIMODAL_API_BASE_URL=
MULTIMODAL_API_KEY=
MULTIMODAL_MODEL=

# Optional server-side TypeSafe Jev title-relevance scoring provider.
# With no key, provider=auto returns review with a null score.
# Never expose the key with a NEXT_PUBLIC_ prefix.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional override; the official default is used when blank.
TYPESAFE_API_BASE_URL=
# Optional local cache for Feeder title scores. Contains hashes and scores, not titles or tags.
FEEDER_SCORE_DB=./.data/scores.db

# Optional public YouTube search for homepage video links and official embeds.
# This API key is separate from the OAuth client below. Server-side only.
YOUTUBE_API_KEY=

# Semantic Scholar and Crossref academic search need no account or API key.
# Optional Google Scholar search through SerpApi (third-party provider quota).
# Only used when Google Scholar is explicitly selected, never by batch harvest.
# Server-side only. Never use a NEXT_PUBLIC_ prefix.
SERPAPI_API_KEY=

# Google OAuth Web application credentials. Enable YouTube Data API v3.
# Register this exact redirect URI in Google Cloud. Server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/connections/youtube/callback
